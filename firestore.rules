rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /texts/{textId} {
      allow read: if request.auth != null && (
        !('visibility' in resource.data) ||
        resource.data.visibility == 'public' ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'shared' && request.auth.uid in resource.data.sharedWith) ||
        exists(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + textId))
      );
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.difficulty in ['beginner','intermediate','advanced']
        && request.resource.data.visibility in ['private','public','shared'];
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.roles.hasOnly(['individual','teacher','student'])
        && request.resource.data.roles.size() == request.resource.data.roles.toSet().size()
        && request.resource.data.roles.size() > 0;
      // Onboarding writes via set(), which Firestore rules treat as `update` (not `create`) for a
      // uid whose doc already exists — this covers accounts registered before roles existed, doing
      // their one-time roles backfill. Once `roles` is present, this branch no longer applies.
      allow update: if request.auth != null && request.auth.uid == userId
        && !('roles' in resource.data)
        && request.resource.data.roles.hasOnly(['individual','teacher','student'])
        && request.resource.data.roles.size() == request.resource.data.roles.toSet().size()
        && request.resource.data.roles.size() > 0;
      allow delete: if false;
    }

    match /emailIndex/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email
        && request.resource.data.roles.hasOnly(['individual','teacher','student'])
        && request.resource.data.roles.size() == request.resource.data.roles.toSet().size();
      allow update, delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if request.auth != null &&
        (resource.data.teacherId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.teacherId
        && connectionId == request.resource.data.teacherId + '_' + request.resource.data.studentId
        && 'teacher' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        && 'student' in get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.roles;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if request.auth != null &&
        (resource.data.teacherId == request.auth.uid || resource.data.studentId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.teacherId
        && assignmentId == request.resource.data.studentId + '_' + request.resource.data.textId
        && 'teacher' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles
        && 'student' in get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.roles
        && exists(/databases/$(database)/documents/connections/$(request.auth.uid + '_' + request.resource.data.studentId));
      allow delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    match /results/{resultId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && resultId == request.resource.data.userId + '_' + request.resource.data.textId
        && (request.resource.data.assignmentId == null ||
            get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.studentId == request.auth.uid);
      allow delete: if false;
    }
  }
}
